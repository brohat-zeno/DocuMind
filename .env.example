APP_NAME=DocuMind
APP_PORT=8000
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documind_documents
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./data/documind.db
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE=800
CHUNK_OVERLAP=100
HISTORY_TURNS=10
MEMORY_TTL_SECONDS=86400
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.58
PROVIDER_TIMEOUT_SECONDS=60
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=local
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_STRUCTURED_MODE=auto
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=./data/documind-embedding-cache
BOOKING_TIMEZONE=Asia/Kathmandu
GROQ_API_KEY=
